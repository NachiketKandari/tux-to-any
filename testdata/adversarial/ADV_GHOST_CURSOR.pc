/* ADV_GHOST_CURSOR — DECLARE + OPEN but never FETCHed or CLOSEd. */
#include <atmi.h>
#include <fml32.h>
#include <sqlca.h>

char c_ServiceName[33];

void SVC_ADV_GHOST(TPSVCINFO* rqst)
{
    FBFR32 *ptr_fml_Ibuffer;
    char c_flag;
    EXEC SQL BEGIN DECLARE SECTION;
        varchar sql_min_acc[12];
    EXEC SQL END DECLARE SECTION;

    ptr_fml_Ibuffer = (FBFR32*)rqst->data;
    strcpy(c_ServiceName,rqst->name);
    Fget32(ptr_fml_Ibuffer,FML_MODE_FLG,0,(char*)&c_flag,0);

    if(c_flag == 'G')
    {
        EXEC SQL
        DECLARE cur_ghost CURSOR FOR
        SELECT MIN_ACC_ID FROM MIN_ACCOUNTS WHERE MIN_ACTIVE = 'A';

        EXEC SQL OPEN cur_ghost;
        /* fetch and close never happen */
    }
    else
    {
        Fadd32(ptr_fml_Ibuffer,FML_ERR_MSG,"bad flag",0);
    }

    tpreturn(TPSUCCESS,0L,0L,0L,0);
}
