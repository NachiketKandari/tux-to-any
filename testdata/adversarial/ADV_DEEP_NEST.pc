/* ADV_DEEP_NEST — eight levels of nested ifs inside one branch: the
 * branching factor doubles per enclosing block (header at depth N
 * contributes +1 x 2^N). Parser must not choke; the math must hold. */
#include <atmi.h>
#include <fml32.h>
#include <sqlca.h>

char c_ServiceName[33];

void SVC_ADV_DEEP(TPSVCINFO* rqst)
{
    FBFR32 *ptr_fml_Ibuffer;
    FBFR32 *ptr_fml_Obuffer;
    char c_flag;
    int a,b,c,d,e,f,g,h;
    EXEC SQL BEGIN DECLARE SECTION;
        varchar sql_min_acc[12];
    EXEC SQL END DECLARE SECTION;

    ptr_fml_Ibuffer = (FBFR32*)rqst->data;
    ptr_fml_Obuffer = (FBFR32*)NULL;
    strcpy(c_ServiceName,rqst->name);
    Fget32(ptr_fml_Ibuffer,FML_MODE_FLG,0,(char*)&c_flag,0);

    if(c_flag == 'D')
    {
        if(a == 1)
        {
            if(b == 2)
            {
                if(c == 3)
                {
                    if(d == 4)
                    {
                        if(e == 5)
                        {
                            if(f == 6)
                            {
                                if(g == 7)
                                {
                                    if(h == 8)
                                    {
                                        EXEC SQL
                                        SELECT MIN_ACC_ID
                                        INTO   :sql_min_acc
                                        FROM   MIN_ACCOUNTS
                                        WHERE  MIN_ACTIVE = 'A';
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    else
    {
        Fadd32(ptr_fml_Obuffer,FML_ERR_MSG,"bad flag",0);
    }

    tpreturn(TPSUCCESS,0L,0L,0L,0);
}
