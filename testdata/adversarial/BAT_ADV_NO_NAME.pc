/* BAT_ADV_NO_NAME — a batch with SQL but no c_ServiceName literal: the
 * module name must fall back to the file basename. */
#include <stdio.h>
#include <sqlca.h>

void main(int argc,char *argv[])
{
    varchar v_id[19];
    long    l_amt;

    EXEC SQL DECLARE cur_nn CURSOR FOR
      SELECT BAT_ID, BAT_AMT FROM MIN_BAT_Q WHERE BAT_ST = 'N';

    EXEC SQL OPEN cur_nn;
    while(1)
    {
      EXEC SQL FETCH cur_nn INTO :v_id, :l_amt;
      if(sqlca.sqlcode != 0)
      {
        break;
      }
    }
    EXEC SQL CLOSE cur_nn;
}
