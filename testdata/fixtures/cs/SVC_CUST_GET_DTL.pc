/*******************************************************************************
 * Name          : SVC_CUST_GET_DTL
 *
 * Version       : 1.0
 *
 * Author        : tuxgo demo corpus
 *
 * Tables Accessed :
 *                 1. CST_MBL_ACCOPN_RQST
 *                 2. CLD_INFO_CLIENT_DTLS
 *                 3. CLF_LEAD_ACC_OPNG_FEE
 *
 * Input Parameters :
 *                 1. Call Flag.
 *                 2. Mobile No.
 *
 * Output Parameters :
 *                 1. Form No
 *                 2. Lead Id
 *                 3. Insert Date
 *                 4. Stage
 *                 5. Final Source
 *                 6. RM Valid Flag
 *
 * Description   :
 *                 Synthetic demo service: dispatches on the call flag; the
 *                 CUSE arm fetches the account-opening request header for a
 *                 mobile number and derives the RM validity flag.
 *
 * Log :
 * 1.0   14/09/2026   New service
 * Reviewed By : demo reviewer
 *******************************************************************************/

/* Standard include files */
#include <atmi.h>
#include <userlog.h>
#include <fml32.h>
#include <string.h>
#include <sqlca.h>
#include <ctype.h>
#include <fn_read_debug_lvl.h>

/* User defined header files */
#include <demo_fml_def.h>
#include <demo_eba.h>

/* Global variables */
char c_ServiceName[33] ;

void SVC_CUST_GET_DTL(TPSVCINFO *rqst)
{
    /* Local variables */
    int i;                       /* Loop counter */
    int i_err[2];                /* Fget/Fadd error codes */
    char c_call_flg[5];          /* dispatch flag */
    char c_arm_flg;              /* normalized dispatch arm */
    char c_numeric;              /* digit check result */
    char c_rm_valid_flag;        /* derived RM validity */
    char c_err_msg[256];
    FBFR32 *ptr_fml_Ibuffer;     /* Input Buffer */
    FBFR32 *ptr_fml_Obuffer;     /* Output Buffer */
    short ind_cst_form;

    /* Include all the header files for variables corresponding to table fields */
    EXEC SQL include "table/cst_mbl_accopn_rqst.h" ;
    EXEC SQL include "table/cld_info_client_dtls.h" ;
    EXEC SQL include "table/clf_lead_acc_opng_fee.h" ;

    EXEC SQL BEGIN DECLARE SECTION;
        varchar sql_cst_form_no[11];
        varchar vc_cst_lead_id[16];
        varchar sql_cst_insert_date[23];
        varchar vc_cst_stage[10];
        varchar vc_cst_final_source[101];
        varchar sql_cst_emp_no[21];
        varchar sql_cst_pan_no[21];
    EXEC SQL END DECLARE SECTION;

    /* Initializations */
    ptr_fml_Ibuffer = (FBFR32*)rqst->data ;
    ptr_fml_Obuffer = (FBFR32*)NULL ;
    strcpy(c_ServiceName, rqst->name) ;
    INITDBGLVL(c_ServiceName);

    userlog("Service :%s: called", c_ServiceName);

    i_err[0] = Fget32(ptr_fml_Ibuffer, FML_FLG, 0, (char *)c_call_flg, 0);
    i_err[1] = Fget32(ptr_fml_Ibuffer, FML_MOBILE_NO, 0, (char *)sql_cst_pan_no.arr, 0);
    for(i = 0; i < 2; i++)
    {
        if(i_err[i] == -1)
        {
            errlog(c_ServiceName, "S31005", FMLMSG, DEF_USR, DEF_SSSN, c_err_msg);
            Fadd32(ptr_fml_Ibuffer, FML_ERR_MSG, c_err_msg, 0);
            tpreturn(TPFAIL, 0L, (char *)ptr_fml_Ibuffer, 0L, 0);
        }
    }

    SETLEN(sql_cst_pan_no);

    userlog("Call Flag :%s:, Mobile No :%s:", c_call_flg, sql_cst_pan_no.arr);

    /* normalize the dispatch flag into a scalar arm selector */
    if(!(strcmp(c_call_flg, "C")))
        c_arm_flg = 'C';
    if(!(strcmp(c_call_flg, "P")))
        c_arm_flg = 'P';

    if((ptr_fml_Obuffer = (FBFR32 *)tpalloc("FML32", NULL, Fneeded32(1, 2048))) == (FBFR32 *)NULL)
    {
        errlog(c_ServiceName, "S31020", TPMSG, DEF_USR, DEF_SSSN, c_err_msg);
        Fadd32(ptr_fml_Ibuffer, FML_ERR_MSG, c_err_msg, 0);
        tpreturn(TPFAIL, 0L, (char *)ptr_fml_Ibuffer, 0L, 0);
    }

    if(c_arm_flg == 'C')
    {
        MEMSET(sql_cst_form_no);
        MEMSET(vc_cst_lead_id);
        MEMSET(sql_cst_insert_date);
        MEMSET(vc_cst_stage);
        MEMSET(vc_cst_final_source);
        MEMSET(sql_cst_emp_no);

        EXEC SQL
          SELECT  NVL(CST_FORM_NO,' '),
                  CST_OBOR_LEAD_ID,
                  to_char(CST_INSERT_DATE,'dd-Mon-yyyy hh24:mi:ss'),
                  CST_OLN_STAGE,
                  NVL(CST_FINAL_SOURCE,' '),
                  NVL(CST_FINAL_EMP_NO,'NA')
          INTO    :sql_cst_form_no:ind_cst_form,
                  :vc_cst_lead_id,
                  :sql_cst_insert_date,
                  :vc_cst_stage,
                  :vc_cst_final_source,
                  :sql_cst_emp_no
          FROM    CST_MBL_ACCOPN_RQST,
                  CLD_INFO_CLIENT_DTLS,
                  CLF_LEAD_ACC_OPNG_FEE
          WHERE   CST_OLN_MOB = :sql_cst_pan_no
          AND     CST_PAN_NO = CLD_PAN_NO(+)
          AND     CST_STATUS IN ('Z','P')
          AND     CST_ACCOPN_SRC = 'E'
          AND     CLF_LEAD_CLOSED(+) = 'N';

        if(SQLCODE != 0 && SQLCODE != NO_DATA_FOUND)
        {
            errlog(c_ServiceName, "S32055", SQLMSG, DEF_USR, DEF_SSSN, c_err_msg);
            Fadd32(ptr_fml_Ibuffer, FML_ERR_MSG, c_err_msg, 0);
            tpreturn(TPFAIL, 0L, (char *)ptr_fml_Ibuffer, 0L, 0);
        }

        userlog("CUSE fetched cst_form_no |%s|, lead |%s|, emp |%s|", sql_cst_form_no.arr, vc_cst_lead_id.arr, sql_cst_emp_no.arr);

        /* FRE-98-style scalar logic: derive the RM validity flag */
        c_rm_valid_flag = 'X';
        c_numeric = 'Y';
        for(i = 0; i < strlen(sql_cst_emp_no.arr); i++)
        {
            if(!isdigit(sql_cst_emp_no.arr[i]))
            {
                c_numeric = 'N';
            }
        }
        userlog("c_numeric :%c:", c_numeric);
        if(c_numeric == 'Y')
        {
            if(strlen(sql_cst_emp_no.arr) == 6)
            {
                if(strcmp(sql_cst_emp_no.arr, "111111") != 0 &&
                   strcmp(sql_cst_emp_no.arr, "222222") != 0 &&
                   strcmp(sql_cst_emp_no.arr, "333333") != 0)
                {
                    c_rm_valid_flag = 'Y';
                }
                else
                {
                    c_rm_valid_flag = 'N';
                }
            }
            else
            {
                c_rm_valid_flag = 'N';
            }
        }
        else
        {
            c_rm_valid_flag = 'N';
        }
        userlog("c_rm_valid_flag :%c:", c_rm_valid_flag);

        Fadd32(ptr_fml_Obuffer, FML_STCK_FRM_ALLWD, sql_cst_form_no.arr, 0);
        Fadd32(ptr_fml_Obuffer, FML_PARAM_DESC, vc_cst_lead_id.arr, 0);
        Fadd32(ptr_fml_Obuffer, FML_RSTRCT_LST_ID, vc_cst_stage.arr, 0);
        Fadd32(ptr_fml_Obuffer, FML_SYSDATE, sql_cst_insert_date.arr, 0);
        Fadd32(ptr_fml_Obuffer, FML_USR_ANSWR1, vc_cst_final_source.arr, 0);
        Fadd32(ptr_fml_Obuffer, FML_LM_FLG, (char *)&c_rm_valid_flag, 0);

        userlog("CUSTOM_EVENTS completed successfully");
    }

    if(c_arm_flg == 'P')
    {
        userlog("PORT arm: portal flow handled by the portal service");
    }

    userlog("SVC_CUST_GET_DTL completed");
    tpreturn(TPSUCCESS, 0L, (char *)ptr_fml_Obuffer, 0L, 0);
}
