/* BAT_ADV_NESTED_LOOPS — a while inside a while with SQL in the inner
 * loop: phase segmentation must keep the blocks straight. */
#include <stdio.h>
#include <sqlca.h>

void main(int argc,char *argv[])
{
    varchar v_id[19];
    varchar v_sub[19];
    long    l_amt;
    int     i;

    EXEC SQL DECLARE cur_outer CURSOR FOR
      SELECT BAT_ID FROM MIN_BAT_Q WHERE BAT_ST = 'N';

    EXEC SQL OPEN cur_outer;
    while(1)
    {
      EXEC SQL FETCH cur_outer INTO :v_id;
      if(sqlca.sqlcode != 0)
      {
        break;
      }
      EXEC SQL DECLARE cur_inner CURSOR FOR
        SELECT SUB_ID, SUB_AMT FROM MIN_SUB WHERE ID = :v_id;
      EXEC SQL OPEN cur_inner;
      i = 0;
      while(1)
      {
        EXEC SQL FETCH cur_inner INTO :v_sub, :l_amt;
        if(sqlca.sqlcode != 0)
        {
          break;
        }
        i = i + 1;
      }
      EXEC SQL CLOSE cur_inner;
      EXEC SQL UPDATE MIN_BAT_Q SET CNT = :i WHERE BAT_ID = :v_id;
    }
    EXEC SQL CLOSE cur_outer;
}
